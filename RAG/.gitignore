data/documents/university_rules/*.pdf
data/documents/university_rules/*.docx

# Keep directory structure
!data/documents/university_rules/.gitkeep
!data/vector_store/chroma_db/.gitkeep

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Models cache
.cache/
models/

