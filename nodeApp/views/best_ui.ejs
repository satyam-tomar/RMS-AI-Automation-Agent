                        <div
                            class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-cyan-600 flex items-center justify-center mx-auto mb-6">
                            <i class="fas fa-question-circle text-2xl text-white"></i>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Ask Query</h3>
                        <p class="text-slate-400 text-sm mb-6">Get quick answers to your questions</p>
                        <button onclick="openService('query')"
                            class="w-full px-4 py-3 rounded-xl bg-blue-500/20 text-blue-300 border border-blue-500/30 hover:bg-blue-500/30 transition">
                            <i class="fas fa-arrow-right mr-2"></i> Ask Now
                        </button>
                    </div>

                    <!-- Get Enquiry Card -->
                    <div class="card-hover glass-dark rounded-2xl p-8 text-center">
                        <div
                            class="w-16 h-16 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center mx-auto mb-6">
                            <i class="fas fa-search text-2xl text-white"></i>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Get Enquiry</h3>
                        <p class="text-slate-400 text-sm mb-6">Check status of your existing cases</p>
                        <button onclick="openService('enquiry')"
                            class="w-full px-4 py-3 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/30 transition">
                            <i class="fas fa-arrow-right mr-2"></i> Check Status
                        </button>
                    </div>

                    <!-- Put Complaint Card -->
                    <div class="card-hover glass-dark rounded-2xl p-8 text-center">
                        <div
                            class="w-16 h-16 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center mx-auto mb-6">
                            <i class="fas fa-file-alt text-2xl text-white"></i>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">Put Complaint</h3>
                        <p class="text-slate-400 text-sm mb-6">Submit a new complaint for resolution</p>
                        <button onclick="openComplaintForm()"
                            class="w-full px-4 py-3 rounded-xl btn-primary text-white font-semibold">
                            <i class="fas fa-arrow-right mr-2"></i> Submit Complaint
                        </button>
                    </div>

                    <!-- More Services Card -->
                    <div class="card-hover glass-dark rounded-2xl p-8 text-center">
                        <div
                            class="w-16 h-16 rounded-full bg-gradient-to-br from-amber-500 to-orange-600 flex items-center justify-center mx-auto mb-6">
                            <i class="fas fa-ellipsis-h text-2xl text-white"></i>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">More Services</h3>
                        <p class="text-slate-400 text-sm mb-6">Explore additional features and support</p>
                        <button onclick="openService('more')"
                            class="w-full px-4 py-3 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/30 hover:bg-amber-500/30 transition">
                            <i class="fas fa-arrow-right mr-2"></i> Explore
                        </button>
                    </div>
                </div>

                <!-- Complaint History Section (Keep this as is) -->
                <div class="glass-dark rounded-2xl overflow-hidden">
                    <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-8 py-6">
                        <h2 class="text-2xl font-bold text-white">
                            <i class="fas fa-history mr-2"></i> Complaint History
                        </h2>
                        <p class="text-indigo-200 text-sm mt-2">Your recent submissions and their status</p>
                    </div>

                    <div class="p-4 max-h-[400px] overflow-y-auto scrollbar-thin">
                        <% if (complaints.length===0) { %>
                            <div class="text-center py-12">
                                <div
                                    class="w-20 h-20 mx-auto mb-4 rounded-full bg-slate-800/50 flex items-center justify-center">
                                    <i class="fas fa-inbox text-3xl text-slate-600"></i>
                                </div>
                                <p class="text-sm font-medium text-slate-400">No complaints yet</p>
                                <p class="text-xs text-slate-500 mt-1">Your submitted complaints will appear here</p>
                                <button onclick="openComplaintForm()"
                                    class="mt-6 px-6 py-3 rounded-xl btn-primary text-white font-semibold text-sm">
                                    <i class="fas fa-plus mr-2"></i> Submit Your First Complaint
                                </button>
                            </div>
                            <% } else { %>
                                <div class="space-y-4">
                                    <% complaints.forEach(c=> { %>
                                        <div class="card-hover cursor-pointer rounded-xl p-5 bg-slate-800/30 border border-slate-700 transition
                                <%= c.status === STATUS.RESOLVED 
                                    ? 'border-l-4 border-l-emerald-500' 
                                    : 'border-l-4 border-l-amber-500' %>" onclick="showComplaint('<%= c.id %>')">

                                            <div class="flex items-start justify-between gap-3 mb-3">
                                                <div class="flex-1 min-w-0">
                                                    <h3 class="font-semibold text-white text-sm line-clamp-1">
                                                        <%= c.subject %>
                                                    </h3>
                                                    <p class="text-[10px] text-slate-400 mt-1">
                                                        <%= new Date(c.createdAt).toLocaleString('en-IN', {
                                                            day: '2-digit' , month: 'short' , year: 'numeric' ,
                                                            hour: '2-digit' , minute: '2-digit' }) %>
                                                    </p>
                                                </div>
                                                <span class="text-[10px] font-semibold px-3 py-1.5 rounded-full whitespace-nowrap
                                        <%= c.status === STATUS.RESOLVED 
                                            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' 
                                            : 'bg-amber-500/20 text-amber-300 border border-amber-500/30' %>">
                                                    <%= c.status %>
                                                </span>
                                            </div>

                                            <p class="text-slate-400 text-xs line-clamp-2 leading-relaxed mb-3">
                                                <%= c.complaintText %>
                                            </p>

                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-2 text-xs text-slate-500">
                                                    <i class="fas fa-clock"></i>
                                                    <span>ID: <%= c.id.slice(0,8) %>...</span>
                                                </div>
                                                <% if (c.status !==STATUS.RESOLVED) { %>
                                                    <button
                                                        onclick="event.stopPropagation(); withdrawComplaint('<%= c.id %>')"
                                                        class="text-[10px] font-semibold px-3 py-1.5 rounded-lg
                                                bg-red-500/20 text-red-300 border border-red-500/30 hover:bg-red-500/30 transition">
                                                        Withdraw
                                                    </button>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } %>
                    </div>
                </div>
            </div>
        </section>
        <section id="submit" class="section-spacing bg-slate-900/50">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-4 gap-8">
                <div class="lg:col-span-8">
                    <div class="glass-dark rounded-2xl overflow-hidden">
                        <div class="bg-gradient-to-r from-indigo-600 to-purple-600 px-8 py-6">
                            <h2 class="text-2xl font-bold text-white">New Complaint Form</h2>
                            <p class="text-indigo-200 text-sm mt-2">AI will analyze your complaint against relevant
                                policies</p>
                        </div>

                        <form action="/submit-complaint" method="POST" class="p-8 space-y-6">
                            <div>
                                <label class="block text-sm font-medium text-slate-300 mb-3">
                                    <i class="fas fa-heading mr-2 text-indigo-400"></i>Subject
                                </label>
                                <input type="text" name="subject" placeholder="Enter complaint subject" class="w-full px-5 py-4 bg-slate-800/50 border border-slate-700 rounded-xl text-white 
                                    focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none 
                                    transition text-sm placeholder:text-slate-500" required>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-300 mb-3">
                                    <i class="fas fa-align-left mr-2 text-indigo-400"></i>Detailed Description
                                </label>
                                <textarea name="complaintText" rows="8"
                                    placeholder="Describe your complaint in detail. Be specific for better AI analysis..."
                                    class="w-full px-5 py-4 bg-slate-800/50 border border-slate-700 rounded-xl text-white 
                                    focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 outline-none 
                                    transition text-sm placeholder:text-slate-500 resize-none" required></textarea>
                                <p class="text-xs text-slate-500 mt-2">
                                    <i class="fas fa-lightbulb mr-1"></i> Include specific details, dates, and policy
                                    references if known
                                </p>
                            </div>

                            <div class="flex items-start gap-3 p-5 bg-slate-800/30 rounded-xl border border-slate-700">
                                <input type="checkbox" id="agree" name="agree" required class="mt-1 h-5 w-5 text-indigo-500 bg-slate-800 border-slate-600 rounded 
                                    focus:ring-2 focus:ring-indigo-500 cursor-pointer">
                                <label for="agree" class="text-sm text-slate-300 cursor-pointer">
                                    I agree that my complaint will be analyzed by AI against organizational policies and
                                    <span class="font-semibold text-indigo-400">Terms of Service</span>
                                </label>
                            </div>

                            <div class="flex items-center gap-4">
                                <button type="submit" class="btn-primary px-8 py-4 rounded-xl text-white font-semibold
                                    flex items-center gap-3">
                                    <i class="fas fa-paper-plane"></i>
                                    <span>Submit Complaint</span>
                                </button>

                            </div>
                        </form>
                    </div>

                    <!-- Complaint Details (Hidden by default) -->
                    <div id="complaintDetails" class="hidden mt-8"></div>
                </div>

            </div>
        </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-12">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid md:grid-cols-4 gap-8">
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <div
                            class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
                            <i class="fas fa-shield-alt text-white"></i>
                        </div>
                        <div>
                            <div class="text-xl font-bold text-white">Complaint<span class="gradient-text">AI</span>
                            </div>
                            <div class="text-xs text-slate-400">Global Platform</div>
                        </div>
                    </div>
                    <p class="text-slate-400 text-sm">
                        AI-powered complaint management system for organizations worldwide.
                    </p>
                </div>

                <div>
                    <h4 class="text-white font-semibold mb-6">Quick Links</h4>
                    <ul class="space-y-3">
                        <li><a href="#home" class="text-slate-400 hover:text-white transition text-sm">Home</a></li>
                        <li><a href="#features" class="text-slate-400 hover:text-white transition text-sm">Features</a>
                        </li>
                        <li><a href="#how-it-works" class="text-slate-400 hover:text-white transition text-sm">How it
                                Works</a></li>
                        <li><a href="#organizations" class="text-slate-400 hover:text-white transition text-sm">For
                                Organizations</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-white font-semibold mb-6">Legal</h4>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-slate-400 hover:text-white transition text-sm">Privacy Policy</a>
                        </li>
                        <li><a href="#" class="text-slate-400 hover:text-white transition text-sm">Terms of Service</a>
                        </li>
                        <li><a href="#" class="text-slate-400 hover:text-white transition text-sm">Cookie Policy</a>
                        </li>
                        <li><a href="#" class="text-slate-400 hover:text-white transition text-sm">GDPR Compliance</a>
                        </li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-white font-semibold mb-6">Contact</h4>
                    <ul class="space-y-3">
                        <li class="flex items-center gap-2 text-slate-400 text-sm">
                            <i class="fas fa-envelope w-4"></i>
                            <span>support@complaintai.com</span>
                        </li>
                        <li class="flex items-center gap-2 text-slate-400 text-sm">
                            <i class="fas fa-phone w-4"></i>
                            <span>+1 (555) 123-4567</span>
                        </li>
                        <li class="flex items-center gap-2 text-slate-400 text-sm">
                            <i class="fas fa-map-marker-alt w-4"></i>
                            <span>Global Headquarters</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-slate-800 mt-12 pt-8 text-center">
                <p class="text-slate-500 text-sm">
                    &copy; 2024 ComplaintAI. All rights reserved. |
                    <span class="text-indigo-400">AI-Powered Complaint Management System</span>
                </p>
            </div>
        </div>
    </footer>

    <!-- Back to Top Button -->
    <button id="backToTop"
        class="fixed bottom-8 right-8 w-12 h-12 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-xl flex items-center justify-center text-white shadow-lg hover:shadow-xl transition-all opacity-0 invisible">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script>
        // Initialize ScrollReveal
        ScrollReveal().reveal('.card-hover, h1, h2, h3, p', {
            delay: 200,
            distance: '30px',
            origin: 'bottom',
            opacity: 0,
            interval: 100,
            duration: 1000,
            reset: false
        });

        // Menu toggle function
        function toggleMenu() {
            const menu = document.getElementById("menuDropdown");
            menu.classList.toggle("hidden");
        }

        // Close menu when clicking outside
        document.addEventListener("click", (e) => {
            const menu = document.getElementById("menuDropdown");
            if (!e.target.closest("#menuDropdown") && !e.target.closest("button[onclick='toggleMenu()']")) {
                menu.classList.add("hidden");
            }
        });

        // Withdraw complaint function
        function withdrawComplaint(id) {
            if (!confirm('Are you sure you want to withdraw this complaint?')) return;

            fetch(`/complaints/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(res => res.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                })
                .catch(err => {
                    console.error(err);
                    alert('Failed to withdraw complaint');
                });
        }

        // Show complaint details
        function showComplaint(id) {
            const detailsContainer = document.getElementById('complaintDetails');

            const existingDetail = document.getElementById('complaint-' + id);
            if (existingDetail && !existingDetail.classList.contains('hidden')) {
                detailsContainer.innerHTML = '';
                detailsContainer.classList.add('hidden');
                return;
            }

            detailsContainer.innerHTML = `
                <div id="complaint-${id}" class="glass-dark rounded-2xl overflow-hidden">
                    <div class="bg-gradient-to-r from-emerald-600 to-teal-500 px-8 py-6">
                        <h2 class="text-xl font-bold text-white">Complaint Details</h2>
                        <p class="text-emerald-100 text-sm mt-1">Complete information and AI analysis</p>
                    </div>
                    <div class="p-8">
                        <div class="grid md:grid-cols-2 gap-6 mb-6">
                            <div class="bg-slate-800/30 rounded-xl p-5">
                                <h4 class="text-sm font-semibold text-slate-300 mb-2">Complaint ID</h4>
                                <p class="text-white font-mono">${id}</p>
                            </div>
                            <div class="bg-slate-800/30 rounded-xl p-5">
                                <h4 class="text-sm font-semibold text-slate-300 mb-2">AI Analysis Status</h4>
                                <div class="flex items-center gap-2">
                                    <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                                    <span class="text-emerald-400 text-sm">Processing Policies</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-slate-400 text-sm">
                            Additional details, AI analysis results, and resolution progress will appear here as your complaint is processed.
                        </p>
                    </div>
                </div>
            `;
            detailsContainer.classList.remove('hidden');
            detailsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Back to top button
        const backToTopBtn = document.getElementById('backToTop');

        window.addEventListener('scroll', () => {
            if (window.pageYOffset > 300) {
                backToTopBtn.classList.remove('opacity-0', 'invisible');
                backToTopBtn.classList.add('opacity-100', 'visible');
            } else {
                backToTopBtn.classList.remove('opacity-100', 'visible');
                backToTopBtn.classList.add('opacity-0', 'invisible');
            }
        });

        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        // Add active class to navigation links on scroll
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('nav a[href^="#"]');

        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.clientHeight;
                if (scrollY >= (sectionTop - 200)) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('text-white');
                link.classList.add('text-slate-300');
                if (link.getAttribute('href') === `#${current}`) {
                    link.classList.remove('text-slate-300');
                    link.classList.add('text-white');
                }
            });
        });

        // Form submission animation
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', (e) => {
                const submitBtn = form.querySelector('button[type="submit"]');
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Processing...';
                submitBtn.disabled = true;

                // The form will submit normally, backend will handle it
            });
        }
    </script>

</body>

</html>