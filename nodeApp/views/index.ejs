<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#FBF1F1] min-h-screen flex items-center justify-center">
    <div class="flex w-full shadow-lg overflow-hidden h-screen">

        <!-- Left Image Section -->
        <div class="w-1/2 h-full">
            <img src="/assets/main_page.jpg" alt="Complaint Management" class="w-full h-full object-cover">
        </div>

        <!-- Right Login Section -->
        <div class="w-1/2 p-10 flex flex-col items-center justify-center">
            <div class="w-4/5">

                <!-- Logo and Title -->
                <div class="flex mb-8">
                    <img src="/assets/lpu_logo.png" alt="lpu"
                        class="h-[80px] w-auto object-contain rounded-lg shadow-sm">
                    <div class="pl-6">
                        <span class="text-3xl text-orange-500 font-bold">RMS</span>
                        <h1 class="text-2xl font-bold text-gray-800 mb-2">Relationship Management System</h1>
                        <p class="text-gray-600">Submit and manage complaints efficiently</p>
                    </div>
                </div>

                <!-- Form Card -->
                <div class="bg-white p-[30px] m-[70px] rounded-xl shadow-xl">

                    <!-- ✅ ERROR BANNER -->
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="mb-4 px-4 py-3 bg-red-100 border border-red-300 text-red-700 rounded-xl text-sm">
                            <%= error %>
                        </div>
                    <% } %>

                    <form class="space-y-6" action="/login" method="post">

                        <!-- Role Dropdown -->
                        <div class="flex items-center">
                            <span class="text-2xl w-[30%]">Log in</span>
                            <div class="w-[70%]">
                                <select id="role" name="role"
                                    class="bg-[#FBF1F1] w-full rounded-xl p-3 focus:ring-2 focus:ring-[#FBF1F1] focus:border-[#FBF1F1]">
                                    <option value="" selected disabled>Select Role</option>
                                    <option value="student">Student</option>
                                    <option value="teacher">Teacher</option>
                                </select>
                            </div>
                        </div>

                        <!-- User ID -->
                        <div>
                            <input type="text" id="userId" name="user_id" placeholder="User ID"
                                class="w-full bg-[#FBF1F1] rounded-xl p-3 focus:ring-[#FBF1F1] focus:border-[#FBF1F1]">
                        </div>

                        <!-- Password -->
                        <div>
                            <input type="password" id="password" name="password" placeholder="Password"
                                class="w-full bg-[#FBF1F1] rounded-xl p-3 focus:ring-[#FBF1F1] focus:border-[#FBF1F1]">
                        </div>

                        <!-- Login Button -->
                        <button type="submit"
                            class="w-full bg-orange-400 text-white py-3 rounded-xl font-semibold hover:bg-orange-500 transition">
                            Login
                        </button>

                        <p class="text-gray-500 text-center text-sm mt-4">
                            <a href="#" class="text-gray-600">Forgot your password?</a>
                        </p>

                    </form>
                </div>

            </div>
        </div>
    </div>
</body>
</html>