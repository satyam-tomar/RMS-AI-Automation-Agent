<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-orange-400 min-h-screen text-gray-800">

    <!-- Top Bar -->
    <div class="h-[64px] w-full bg-white shadow-md flex justify-between items-center px-6 mb-6 border-b border-gray-200">

        <!-- Left: Logo -->
        <div class="flex items-center gap-3">
            <img src="/assets/LPU.jpg" alt="LPU Logo" class="h-12 w-auto object-contain rounded-lg shadow-sm">
        </div>

        <!-- Right: Teacher Info + Menu -->
        <div class="flex items-center gap-4 relative">

            <div class="flex flex-col items-end leading-tight">
                <span class="font-semibold text-gray-900 text-[15px] tracking-tight">
                    <span class="text-blue-600"><%= teacherName %></span>
                </span>
                <span class="text-[13px] text-gray-600 font-medium">
                    Id. No.: <%= teacherId %>
                </span>
            </div>

            <!-- Hidden Menu under 3-dots -->
            <div class="relative">
                <button onclick="toggleMenu()"
                    class="p-2 rounded-full hover:bg-gray-100 transition active:scale-95 text-gray-700">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7"
                        stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
                    </svg>
                </button>

                <div id="menuDropdown"
                    class="hidden absolute right-0 mt-2 w-36 bg-white rounded-2xl shadow-xl border border-gray-100 py-2 z-50">
                    <a href="/student/logout"
                        class="block px-4 py-2 text-[14px] text-red-600 hover:bg-gray-100 rounded-xl">
                        Logout
                    </a>
                </div>
            </div>

        </div>
    </div>

    <div class="flex max-w-7xl mx-auto bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-200">

        <!-- Left: Complaints Sidebar -->
        <div class="w-1/3 p-6 bg-gray-50 overflow-y-auto">

            <div class="relative bg-white h-[680px] rounded-2xl border border-orange-400 shadow-xl hover:shadow-2xl p-4">

                <span
                    class="absolute -top-3 left-6 bg-orange-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                    All Complaints
                </span>

                <div class="mt-4 space-y-3 max-h-[620px] overflow-y-auto">

                    <% if (pendingComplaints.length === 0 && resolvedComplaints.length === 0) { %>
                        <div class="text-center text-gray-500 mt-10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 mx-auto mb-3 text-gray-400"
                                fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M3 8l7.89 5.26a2.5 2.5 0 002.78 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            <p>No Complaints Yet</p>
                        </div>
                    <% } else { %>

                        <% pendingComplaints.forEach(c => { %>
                            <div
                                class="p-4 rounded-xl cursor-pointer shadow-sm hover:shadow-md border-l-4 border-red-400 bg-red-50/60 transition-all"
                                onclick="showComplaint('<%= c.id %>')">
                                <p class="font-medium text-[14px] text-gray-900 truncate">
                                    <%= c.studentName %>
                                </p>
                                <p class="text-gray-700 text-[13px] truncate mt-1">
                                    <%= c.subject %>
                                </p>
                                <span
                                    class="mt-2 inline-block text-[11px] font-semibold px-2 py-1 rounded-lg bg-red-100 text-red-800">
                                    Pending
                                </span>
                            </div>
                        <% }) %>

                        <% resolvedComplaints.forEach(c => { %>
                            <div
                                class="p-4 rounded-xl cursor-pointer shadow-sm hover:shadow-md border-l-4 border-green-500 bg-green-50/60 transition-all"
                                onclick="showComplaint('<%= c.id %>')">
                                <p class="font-medium text-[14px] text-gray-900 truncate">
                                    <%= c.studentName %>
                                </p>
                                <p class="text-gray-700 text-[13px] truncate mt-1">
                                    <%= c.subject %>
                                </p>
                                <span
                                    class="mt-2 inline-block text-[11px] font-semibold px-2 py-1 rounded-lg bg-green-100 text-green-800">
                                    Resolved
                                </span>
                            </div>
                        <% }) %>

                    <% } %>
                </div>
            </div>
        </div>

        <!-- Right Panel -->
        <div class="w-2/3 p-8 overflow-y-auto h-[680px] bg-gray-50">

            <div class="relative bg-white p-6 rounded-2xl border border-orange-400 shadow-xl hover:shadow-2xl">

                <span
                    class="absolute -top-3 left-6 bg-orange-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                    Complaint Details
                </span>

                <!-- Single Dynamic Section -->
                <div id="complaint-details" class="hidden mt-4">

                    <p class="text-sm text-gray-700">
                        <span class="font-semibold">Student:</span>
                        <span id="cd-student"></span>
                    </p>

                    <p class="mt-3 text-[15px] font-semibold text-gray-900">
                        Subject: <span id="cd-subject"></span>
                    </p>

                    <p class="mt-2 text-sm text-gray-700 whitespace-pre-line leading-relaxed" id="cd-text"></p>

                    <!-- AI Solution Block -->
                    <div id="cd-ai-block" class="mt-6 p-5 bg-gray-50 border border-gray-200 rounded-xl">
                        <p class="text-sm font-semibold text-gray-800 mb-3">AI-generated Solution</p>
                        <p id="cd-ai" class="text-gray-700 text-[14px] whitespace-pre-line leading-relaxed"></p>
                        <form action="/teacher-action" method="POST" class="mt-4">
                            <input type="hidden" id="cd-approve-id" name="complaintId">
                            <input type="hidden" name="action" value="approve">
                            <button type="submit"
                                class="bg-green-600 hover:bg-green-700 transition text-white px-4 py-2.5 rounded-xl text-sm font-medium shadow active:scale-95">
                                Approve AI Solution
                            </button>
                        </form>
                    </div>

                    <!-- Manual Solution Block -->
                    <div class="mt-6 p-5 bg-yellow-50 border border-yellow-200 rounded-xl">
                        <p class="text-sm font-semibold text-gray-800 mb-2">Manual Response</p>
                        <form action="/teacher-action" method="POST">
                            <input type="hidden" id="cd-manual-id" name="complaintId">
                            <input type="hidden" name="action" value="manual">
                            <input type="hidden" name="shouldPolish" value="true">
                            <textarea name="manualResponse" rows="6"
                                class="w-full border border-gray-300 rounded-xl px-3 py-2 text-[14px] focus:ring-2 focus:ring-blue-400 outline-none resize-none leading-relaxed"
                                placeholder="Write your manual response here..."></textarea>
                            <div class="mt-3 flex justify-end">
                                <button type="submit"
                                    class="bg-blue-600 hover:bg-blue-700 transition text-white px-4 py-2.5 rounded-xl text-sm font-medium shadow active:scale-95">
                                    Send Manual Solution
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        const complaints = {
            <% pendingComplaints.concat(resolvedComplaints).forEach(c => { %>
                "<%= c.id %>": {
                    id: "<%= c.id %>",
                    studentName: "<%= c.studentName %>",
                    subject: "<%= c.subject %>",
                    complaintText: `<%= c.complaintText %>`,
                    aiDraft: `<%= c.aiDraft %>`
                },
            <% }) %>
        };

        function showComplaint(id) {
            const data = complaints[id];
            if (!data) return;
            document.getElementById("cd-student").textContent = data.studentName;
            document.getElementById("cd-subject").textContent = data.subject;
            document.getElementById("cd-text").textContent = data.complaintText;
            document.getElementById("cd-ai").textContent = data.aiDraft;
            document.getElementById("cd-approve-id").value = data.id;
            document.getElementById("cd-manual-id").value = data.id;
            document.getElementById("complaint-details").classList.remove("hidden");
        }

        function toggleMenu() {
            const menu = document.getElementById("menuDropdown");
            menu.classList.toggle("hidden");
        }

        document.addEventListener("click", (e) => {
            const menu = document.getElementById("menuDropdown");
            if (!e.target.closest("#menuDropdown") && !e.target.closest("button")) {
                menu.classList.add("hidden");
            }
        });
    </script>

</body>

</html>
