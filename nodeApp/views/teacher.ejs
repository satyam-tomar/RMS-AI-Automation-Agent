<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RMS – Teacher Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        * {
            font-family: 'Inter', sans-serif;
        }

        .card-hover {
            transition: all .2s ease;
        }

        .card-hover:hover {
            transform: translateY(-2px);
        }

        .scrollbar-thin::-webkit-scrollbar {
            width: 4px;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
    </style>
</head>

<body class="min-h-screen bg-[#FBF1F1]">

    <!-- Top Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 shadow-sm">
        <div class="max-w-[1400px] mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-4">
                <img src="/assets/LPU.jpg" class="h-11 rounded-lg" />
                <div class="hidden sm:block border-l pl-4">
                    <p class="font-bold text-gray-900">RMS – Teacher</p>
                    <p class="text-xs text-gray-500">Complaint Management</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-sm font-semibold text-gray-900">
                        <%= teacherName %>
                    </p>
                    <p class="text-xs text-gray-500">
                        <%= teacherId %>
                    </p>
                </div>
                <div class="relative">
                    <button onclick="toggleMenu()" class="p-2 rounded-lg hover:bg-gray-50">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                            stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
                        </svg>
                    </button>
                    <div id="menuDropdown"
                        class="hidden absolute right-0 mt-2 w-40 bg-white rounded-lg shadow border py-1">
                        <a href="/teacher/logout"
                            class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-50">Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="pt-20 max-w-[1400px] mx-auto px-6 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Complaints List -->
            <div class="lg:col-span-4">
                <div class="bg-white rounded-2xl shadow-sm border overflow-hidden sticky top-24">
                    <div class="bg-gradient-to-r from-orange-400 to-orange-500 px-6 py-5">
                        <h2 class="text-lg font-semibold text-white">All Complaints</h2>
                        <p class="text-orange-100 text-sm">Pending & resolved</p>
                    </div>
                    <div class="p-4 space-y-3 max-h-[600px] overflow-y-auto scrollbar-thin">
                        <% pendingComplaints.forEach(c=> { %>
                            <div onclick="showComplaint('<%= c.id %>')"
                                class="card-hover cursor-pointer p-4 rounded-xl border bg-amber-50/60">
                                <p class="text-sm font-semibold text-gray-900 line-clamp-1">
                                    <%= c.subject %>
                                </p>
                                <p class="text-xs text-gray-600 mt-1">
                                    <%= c.studentName %>
                                </p>
                                <span
                                    class="inline-block mt-2 text-[10px] bg-amber-500 text-white px-2 py-1 rounded-full">Pending</span>
                            </div>
                            <% }) %>
                                <% resolvedComplaints.forEach(c=> { %>
                                    <div onclick="showComplaint('<%= c.id %>')"
                                        class="card-hover cursor-pointer p-4 rounded-xl border bg-green-50/60">
                                        <p class="text-sm font-semibold text-gray-900 line-clamp-1">
                                            <%= c.subject %>
                                        </p>
                                        <p class="text-xs text-gray-600 mt-1">
                                            <%= c.studentName %>
                                        </p>
                                        <span
                                            class="inline-block mt-2 text-[10px] bg-green-500 text-white px-2 py-1 rounded-full">Resolved</span>
                                    </div>
                                    <% }) %>
                    </div>
                </div>
            </div>

            <!-- Complaint Details -->
            <div class="lg:col-span-8">
                <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
                    <div class="bg-gradient-to-r from-orange-500 to-orange-400 px-6 py-5">
                        <h2 class="text-lg font-semibold text-white">Complaint Details</h2>
                        <p class="text-green-100 text-sm">Review and respond</p>
                    </div>
                    <div id="complaint-details" class="hidden p-6 space-y-5">
                        <p class="text-sm"><span class="font-semibold">Student:</span> <span id="cd-student"></span></p>
                        <p class="text-sm"><span class="font-semibold">Reg. no.: </span><span id="cd-student-id"></span>
                        </p>
                        <p class="text-sm font-semibold">Subject: <span id="cd-subject"></span></p>
                        <p id="cd-text" class="text-sm text-gray-700 whitespace-pre-line"></p>

                        <div class="bg-gray-50 border rounded-xl p-5">
                            <div class="flex justify-between">
                                <p class="text-sm font-semibold mb-2">AI Suggested Response</p>
                                <button class="text-[10px] font-semibold px-2.5 py-1 rounded-full
                            bg-orange-500 text-white hover:bg-orange-600 transition">Edit Response</button>
                            </div>
                            <p id="cd-ai" class="text-sm text-gray-700 whitespace-pre-line"></p>
                            <form action="/teacher-action" method="POST" class="mt-4">
                                <input type="hidden" id="cd-approve-id" name="complaintId" />
                                <input type="hidden" name="action" value="approve" />
                                <button
                                    class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm">Approve
                                    AI </button>
                            </form>
                        </div>

                        <div class="bg-orange-50 border rounded-xl p-5">
                            <p class="text-sm font-semibold mb-2">Manual Response</p>
                            <form action="/teacher-action" method="POST">
                                <input type="hidden" id="cd-manual-id" name="complaintId" />
                                <input type="hidden" name="action" value="manual" />
                                <textarea name="manualResponse" rows="5"
                                    class="w-full border rounded-lg p-3 text-sm"></textarea>
                                <div class="mt-3 text-right">
                                    <button
                                        class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg text-sm">Send</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function toggleMenu() { document.getElementById('menuDropdown').classList.toggle('hidden') }
        const complaints = {
<% pendingComplaints.concat(resolvedComplaints).forEach(c => { %>
            "<%= c.id %>": { id: "<%= c.id %>", userId: "<%= c.studentId%>", student: "<%= c.studentName %>", subject: "<%= c.subject %>", text: `<%= c.complaintText %>`, ai: `<%= c.aiDraft %>` },
<% }) %>
};
        function showComplaint(id) { const d = complaints[id]; if (!d) return; document.getElementById('cd-student').textContent = d.student; document.getElementById('cd-subject').textContent = d.subject; document.getElementById('cd-student-id').textContent = d.userId; document.getElementById('cd-text').textContent = d.text; document.getElementById('cd-ai').textContent = d.ai; document.getElementById('cd-approve-id').value = d.id; document.getElementById('cd-manual-id').value = d.id; document.getElementById('complaint-details').classList.remove('hidden'); }
    </script>
</body>

</html>