<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal · LPU</title>
    <!-- Tailwind + custom layer -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font & extra styles -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', system-ui, sans-serif; }
        body {
            background: radial-gradient(circle at 10% 30%, rgba(99,102,241,0.08) 0%, transparent 30%),
                        radial-gradient(circle at 90% 70%, rgba(236,72,153,0.06) 0%, transparent 35%),
                        linear-gradient(145deg, #f9fafb 0%, #f1f5f9 100%);
            background-attachment: fixed;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 20px 35px -8px rgba(0,0,0,0.1), 0 0 0 1px rgba(255,255,255,0.6) inset;
        }
        .glass-card-solid {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(224, 231, 255, 0.6);
            box-shadow: 0 20px 35px -8px rgba(0,0,0,0.1), 0 0 0 1px rgba(255,255,255,0.6) inset;
        }
        .nav-blur {
            background: rgba(255,255,255,0.7);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-bottom: 1px solid rgba(226, 232, 240, 0.5);
        }
        .history-item {
            transition: all 0.25s cubic-bezier(0.2,0,0,1);
            border: 1px solid transparent;
        }
        .history-item:hover {
            transform: scale(1.01) translateY(-2px);
            border-color: #c7d2fe;
            background: rgba(255,255,255,0.95);
            box-shadow: 0 20px 30px -12px rgba(79, 70, 229, 0.2);
        }
        .detail-slide {
            animation: slideReveal 0.4s cubic-bezier(0.2,0,0,1);
        }
        @keyframes slideReveal {
            0% { opacity: 0; transform: translateY(24px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .badge-pulse {
            animation: pulseGlow 2s infinite;
        }
        @keyframes pulseGlow {
            0%,100% { box-shadow: 0 0 0 0 rgba(99,102,241,0.3); }
            50% { box-shadow: 0 0 0 6px rgba(99,102,241,0.1); }
        }
        .scrollbar-thin::-webkit-scrollbar {
            width: 5px;
        }
        .scrollbar-thin::-webkit-scrollbar-track {
            background: #eef2f6;
            border-radius: 10px;
        }
        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #a5b4fc;
            border-radius: 10px;
        }
        .scrollbar-thin::-webkit-scrollbar-thumb:hover {
            background: #818cf8;
        }
    </style>
</head>
<body class="min-h-screen text-slate-700 antialiased">

    <!-- ========== FLOATING NAV (glass) ========== -->
    <nav class="nav-blur fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 lg:px-8 h-16 flex items-center">
        <div class="max-w-7xl w-full mx-auto flex justify-between items-center">
            <!-- left: logo + portal -->
            <div class="flex items-center gap-3">
                <div class=" w-[120px] "><img src="/assets/lpu.jpg" alt="LPU Logo"></div>
                <div class="hidden sm:block h-6 w-px bg-slate-300/70"></div>
                <div>
                    <h1 class="font-bold text-base tracking-tight text-slate-800">LPU <span class="text-orange-600">RMS</span></h1>
                    <p class="text-[10px] leading-tight text-slate-500">Lovely Professional University</p>
                </div>
            </div>

            <!-- right: notifications + profile -->
            <div class="flex items-center gap-2">
                <!-- notification bell with dot -->
                <!-- <button class="relative p-2.5 rounded-xl hover:bg-white/60 transition">
                    <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                    <span class="absolute top-2 right-2 w-2 h-2 bg-rose-500 rounded-full ring-2 ring-white"></span>
                </button> -->

                <!-- user menu -->
                <div class="flex items-center gap-2 pl-2 border-l border-slate-200/70">
                    <div class="text-right hidden sm:block">
                        <p class="text-sm font-semibold text-slate-800"><%= studentName %></p>
                        <p class="text-[10px] text-slate-500"><%= studentId %></p>
                    </div>
                    <div class="relative">
                        <button onclick="toggleMenu()" class="flex items-center gap-1 p-1.5 rounded-xl hover:bg-white/70 transition">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-orange-500 to-orange-500 text-white flex items-center justify-center font-semibold text-base shadow-md">
                                <%= studentName ? studentName.charAt(0).toUpperCase() : 'S' %>
                            </div>
                            <svg class="w-4 h-4 text-slate-600 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <!-- dropdown menu -->
                        <div id="menuDropdown" class="hidden absolute right-0 mt-2 w-48 bg-white/90 backdrop-blur-lg rounded-2xl shadow-xl border border-white/50 py-2 z-50">
                            <a href="#" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-indigo-50 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                Profile
                            </a>
                            <a href="#" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-indigo-50 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                Settings
                            </a>
                            <hr class="my-2 border-slate-200">
                            <a href="/student/logout" class="flex items-center gap-3 px-4 py-2.5 text-sm text-rose-600 hover:bg-rose-50 transition">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- ========== MAIN CONTENT (pt-20 for fixed nav) ========== -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12">
        
        <!-- page header with micro interaction -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-3xl font-bold bg-gradient-to-r from-gray-700 to-gray-700 bg-clip-text text-transparent">RMS - Request Management System</h2>
                <p class="text-slate-500 text-sm mt-1 flex items-center gap-1">
                    <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> 
                    submit & track requests in real-time
                </p>
            </div>
        </div>

        <!-- ========== STATS CARDS (refreshed) ========== -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
            <!-- total requests -->
            <div class="glass-card rounded-2xl p-5 flex items-center justify-between group">
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">total requests</p>
                    <p class="text-3xl font-bold text-slate-800 mt-1"><%= complaints.length %></p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-indigo-100/70 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                </div>
            </div>
            <!-- pending -->
            <div class="glass-card rounded-2xl p-5 flex items-center justify-between group">
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">pending</p>
                    <p class="text-3xl font-bold text-amber-600 mt-1"><%= complaints.filter(c => c.status !== STATUS.RESOLVED).length %></p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-100/70 text-amber-600 flex items-center justify-center group-hover:scale-110 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
            </div>
            <!-- resolved -->
            <div class="glass-card rounded-2xl p-5 flex items-center justify-between group">
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">resolved</p>
                    <p class="text-3xl font-bold text-emerald-600 mt-1"><%= complaints.filter(c => c.status === STATUS.RESOLVED).length %></p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-100/70 text-emerald-600 flex items-center justify-center group-hover:scale-110 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
            </div>
        </div>

        <!-- ========== 2-COLUMN LAYOUT ========== -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-7">
            <!-- LEFT: FORM + DETAILS (col-span-2) -->
            <div class="lg:col-span-2 space-y-6">

                <!-- NEW REQUEST CARD (glass) -->
                <div class="glass-card-solid rounded-2xl overflow-hidden">
                    <div class="px-6 py-5 border-b border-slate-200/70 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 to-orange-500 flex items-center justify-center shadow-md">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-800">create new request</h3>
                            <p class="text-xs text-slate-500">all fields are required</p>
                        </div>
                    </div>

                    <form action="/submit-complaint" method="POST" class="p-6 space-y-5">
                        <div class="space-y-1.5">
                            <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide">subject</label>
                            <input type="text" name="subject" placeholder="e.g. hostel maintenance, fee receipt..." 
                                class="w-full px-4 py-3 bg-white/60 border border-slate-200 rounded-xl text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-indigo-300/60 focus:border-indigo-300 outline-none transition text-sm"
                                required>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide">description</label>
                            <textarea name="complaintText" rows="5" placeholder="provide detailed information..." 
                                class="w-full px-4 py-3 bg-white/60 border border-slate-200 rounded-xl text-slate-800 placeholder:text-slate-400 focus:ring-2 focus:ring-indigo-300/60 focus:border-indigo-300 outline-none transition text-sm resize-none"
                                required></textarea>
                        </div>

                        <div class="flex items-start gap-3 p-4 bg-indigo-50/70 rounded-xl border border-indigo-200">
                            <input type="checkbox" id="agree" name="agree" required 
                                class="mt-0.5 h-4 w-4 text-indigo-600 border-indigo-300 rounded-md focus:ring-indigo-400">
                            <label for="agree" class="text-xs text-indigo-800 cursor-pointer">I confirm that the information provided is accurate and agree to the <span class="font-semibold">terms of service</span>.</label>
                        </div>

                        <button type="submit" 
                            class="w-full sm:w-auto bg-gradient-to-r from-indigo-500 to-purple-500 hover:from-indigo-600 hover:to-purple-600 text-white px-6 py-3 rounded-2xl text-sm font-semibold shadow-lg shadow-indigo-200 flex items-center justify-center gap-2 transition-all">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                            <span>submit request</span>
                        </button>
                    </form>
                </div>

                <!-- DYNAMIC DETAILS PANEL (hidden by default) -->
                <div id="complaintDetails" class="hidden detail-slide"></div>
            </div>

            <!-- RIGHT: HISTORY SIDEBAR (glass) -->
            <div class="lg:col-span-1">
                <div class="glass-card-solid rounded-2xl overflow-hidden sticky top-24">
                    <div class="px-5 py-5 border-b border-slate-200/70 flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-orange-100 flex items-center justify-center text-orange-600">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-800">request history</h3>
                            <p class="text-[10px] text-slate-500">latest first</p>
                        </div>
                    </div>

                    <div class="p-3 max-h-[calc(100vh-280px)] overflow-y-auto scrollbar-thin">
                        <% if (complaints.length === 0) { %>
                            <div class="text-center py-12 px-2">
                                <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-300">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
                                </div>
                                <p class="text-sm font-medium text-slate-600">no requests yet</p>
                                <p class="text-xs text-slate-400 mt-1">submit your first request above</p>
                            </div>
                        <% } else { %>
                            <div class="space-y-2.5">
                                <% complaints.slice().reverse().forEach(c => {   /* reversed to show latest first */ %>
                                    <div class="history-item cursor-pointer rounded-xl p-4 bg-white/70 backdrop-blur-sm border border-slate-200/70
                                                <%= c.status === STATUS.RESOLVED ? 'hover:border-emerald-300' : 'hover:border-amber-300' %>"
                                         data-id="<%= c.id %>"
                                         data-subject="<%= c.subject %>"
                                         data-text="<%= c.complaintText %>"
                                         data-response="<%= c.finalResponse || 'No response yet' %>"
                                         data-status="<%= c.status %>"
                                         data-date="<%= new Date(c.createdAt).toLocaleString('en-IN', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>"
                                         onclick="showComplaint(this)">

                                        <div class="flex items-start justify-between gap-1 mb-2">
                                            <h4 class="font-semibold text-sm text-slate-800 line-clamp-1"><%= c.subject %></h4>
                                            <span class="shrink-0 px-2 py-0.5 text-[9px] font-bold rounded-full uppercase tracking-wide
                                                <%= c.status === STATUS.RESOLVED ? 'bg-emerald-100 text-emerald-700 border border-emerald-300' : 'bg-amber-100 text-amber-700 border border-amber-300' %>">
                                                <%= c.status === STATUS.RESOLVED ? '✓ done' : '⋯ pend' %>
                                            </span>
                                        </div>

                                        <p class="text-xs text-slate-500 line-clamp-2 mb-2"><%= c.complaintText %></p>

                                        <div class="flex items-center justify-between text-[10px] text-slate-400">
                                            <span class="flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                <%= new Date(c.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short' }) %>
                                            </span>
                                            <% if (c.status !== STATUS.RESOLVED) { %>
                                                <button onclick="event.stopPropagation(); withdrawComplaint('<%= c.id %>')"
                                                    class="text-[9px] font-semibold px-2 py-1 rounded-full bg-rose-100 text-rose-700 hover:bg-rose-200 transition border border-rose-200">
                                                    withdraw
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ========== JAVASCRIPT (same logic, enhanced UI behaviour) ========== -->
    <script>
        // Toggle dropdown menu
        function toggleMenu() {
            const menu = document.getElementById("menuDropdown");
            menu.classList.toggle("hidden");
        }
        document.addEventListener("click", (e) => {
            const menu = document.getElementById("menuDropdown");
            if (!e.target.closest("#menuDropdown") && !e.target.closest("button[onclick='toggleMenu()']")) {
                menu.classList.add("hidden");
            }
        });

        // Withdraw complaint (identical backend call)
        function withdrawComplaint(id) {
            if (!confirm('Withdraw this request? this action cannot be undone.')) return;
            fetch(`/complaints/${id}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } })
                .then(res => res.json())
                .then(data => { alert(data.message); location.reload(); })
                .catch(() => alert('Failed to withdraw'));
        }

        // Show complaint details (enhanced panel, but keeps data compatibility)
        function showComplaint(element) {
            const id = element.getAttribute('data-id');
            const subject = element.getAttribute('data-subject');
            const text = element.getAttribute('data-text');
            const response = element.getAttribute('data-response');
            const status = element.getAttribute('data-status');
            const date = element.getAttribute('data-date');

            const container = document.getElementById('complaintDetails');

            // toggle if same already open?
            const existing = document.getElementById('complaint-' + id);
            if (existing && !container.classList.contains('hidden')) {
                container.innerHTML = '';
                container.classList.add('hidden');
                return;
            }

            const statusBg = status === 'RESOLVED' 
                ? 'bg-emerald-50 border-emerald-200 text-emerald-700' 
                : 'bg-amber-50 border-amber-200 text-amber-700';

            const responseHtml = (response && response !== 'No response yet')
                ? `<div class="bg-indigo-50/80 rounded-xl p-5 border border-indigo-200">
                        <div class="flex items-center gap-2 text-indigo-800 text-sm font-medium mb-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
                            <span>admin response</span>
                        </div>
                        <p class="text-sm text-slate-700 leading-relaxed">${response}</p>
                   </div>`
                : `<div class="bg-slate-50/80 rounded-xl p-5 border border-slate-200 text-center">
                        <svg class="w-10 h-10 text-slate-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <p class="text-sm font-medium text-slate-500">awaiting response</p>
                        <p class="text-xs text-slate-400 mt-1">your request is in queue</p>
                   </div>`;

            container.innerHTML = `
                <div id="complaint-${id}" class="glass-card-solid rounded-2xl overflow-hidden detail-slide">
                    <div class="bg-gradient-to-r from-indigo-500 to-purple-500 px-6 py-4 flex justify-between items-center">
                        <h3 class="font-semibold text-white flex items-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                            request summary
                        </h3>
                        <button onclick="closeDetails()" class="text-white/90 hover:bg-white/20 p-1.5 rounded-lg transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                        </button>
                    </div>
                    <div class="p-6 space-y-4">
                        <div class="flex flex-wrap items-center gap-2 text-xs">
                            <span class="bg-slate-100 px-3 py-1.5 rounded-full font-mono">#${id}</span>
                            <span class="flex items-center gap-1 text-slate-500"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>${date}</span>
                            <span class="px-3 py-1.5 rounded-full border ${statusBg} text-xs font-semibold">${status}</span>
                        </div>

                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">subject</p>
                            <p class="text-base font-medium text-slate-800">${subject}</p>
                        </div>

                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">description</p>
                            <div class="bg-slate-50/70 rounded-xl p-4 border border-slate-200 text-sm text-slate-700 leading-relaxed">${text}</div>
                        </div>

                        <div>
                            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">feedback</p>
                            ${responseHtml}
                        </div>
                    </div>
                </div>
            `;

            container.classList.remove('hidden');
            if (window.innerWidth < 1024) {
                setTimeout(() => container.scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
            }
        }

        function closeDetails() {
            document.getElementById('complaintDetails').innerHTML = '';
            document.getElementById('complaintDetails').classList.add('hidden');
        }
    </script>
</body>
</html>