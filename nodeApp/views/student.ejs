<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal - Lovely Professional University</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        * {
            font-family: 'Inter', sans-serif;
        }
        

        .card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        }

        .scrollbar-thin::-webkit-scrollbar {
            width: 6px;
        }

        .scrollbar-thin::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .detail-animation {
            animation: slideUp 0.4s ease;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .status-badge {
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
    </style>
</head>

<body class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">

    <!-- Top Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-4">
                    <img src="/assets/LPU.jpg" alt="LPU Logo" class="h-10 w-35 rounded-lg shadow-sm" />
                    <div class="border-l border-slate-200 pl-4">
                        <h1 class="font-bold text-slate-900 text-sm sm:text-base">Student Portal</h1>
                        <p class="text-xs text-slate-500 hidden sm:block">Lovely Professional University</p>
                    </div>
                </div>
                
                <div class="flex items-center gap-3">
                    <!-- Notifications -->
                    <button class="relative p-2 rounded-lg hover:bg-slate-100 transition hidden sm:block">
                        <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <span class="absolute top-1 right-1 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>

                    <!-- User Menu -->
                    <div class="flex items-center gap-3 border-l border-slate-200 pl-3">
                        <div class="text-right hidden sm:block">
                            <p class="text-sm font-semibold text-slate-900"><%= studentName %></p>
                            <p class="text-xs text-slate-500"><%= studentId %></p>
                        </div>
                        <div class="text-right sm:hidden">
                            <p class="text-xs font-semibold text-slate-900"><%= studentName %></p>
                            <p class="text-[10px] text-slate-500"><%= studentId %></p>
                        </div>
                        <div class="relative">
                            <button onclick="toggleMenu()" class="flex items-center gap-2 p-2 rounded-lg hover:bg-slate-100 transition">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center text-white text-sm font-semibold">
                                    <%= studentName.charAt(0) %>
                                </div>
                                <svg class="w-4 h-4 text-slate-600 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <div id="menuDropdown" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-slate-200 py-2">
                                <a href="#" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                        Profile
                                    </div>
                                </a>
                                <a href="#" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                        Settings
                                    </div>
                                </a>
                                <hr class="my-2 border-slate-200">
                                <a href="/student/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                        </svg>
                                        Logout
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="pt-20 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Header -->
            <div class="mb-6">
                <h2 class="text-2xl font-bold text-slate-900 mb-1">Request Management</h2>
                <p class="text-slate-600">Submit and track your requests</p>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-slate-600">Total Requests</p>
                            <p class="text-2xl font-bold text-slate-900 mt-1"><%= complaints.length %></p>
                        </div>
                        <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-slate-600">Pending</p>
                            <p class="text-2xl font-bold text-amber-600 mt-1"><%= complaints.filter(c => c.status !== STATUS.RESOLVED).length %></p>
                        </div>
                        <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center">
                            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                </div>
                
                <div class="bg-white rounded-xl p-5 shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-medium text-slate-600">Resolved</p>
                            <p class="text-2xl font-bold text-green-600 mt-1"><%= complaints.filter(c => c.status === STATUS.RESOLVED).length %></p>
                        </div>
                        <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Submit Form Section -->
                <div class="lg:col-span-2 space-y-6">
                    
                    <!-- Submit Form Card -->
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div>
                                    <h2 class="text-lg font-semibold text-white">Submit New Request</h2>
                                    <p class="text-orange-100 text-sm">Fill out the form below</p>
                                </div>
                            </div>
                        </div>

                        <form action="/submit-complaint" method="POST" class="p-6 space-y-5">
                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-2">Subject</label>
                                <input type="text" name="subject" placeholder="Enter request subject" 
                                    class="w-full px-4 py-3 border border-blue-300 rounded-lg text-blue-900 
                                    focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none 
                                    transition text-sm placeholder:text-slate-400" required>
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
                                <textarea name="complaintText" rows="8" placeholder="Describe your request in detail..."
                                    class="w-full px-4 py-3 border border-slate-300 rounded-lg text-slate-900 
                                    focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none 
                                    transition text-sm placeholder:text-slate-400 resize-none" required></textarea>
                            </div>

                            <div class="flex items-start gap-3 p-4 bg-blue-50 rounded-lg border border-blue-200">
                                <input type="checkbox" id="agree" name="agree" required 
                                    class="mt-0.5 h-4 w-4 text-blue-500 border-blue-300 rounded 
                                    focus:ring-2 focus:ring-blue-500 cursor-pointer">
                                <label for="agree" class="text-sm text-blue-700 cursor-pointer">
                                    I agree to the <span class="font-semibold text-blue-600">Terms and Conditions</span>
                                </label>
                            </div>

                            <button type="submit" 
                                class="w-full sm:w-auto bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 
                                text-white px-6 py-3 rounded-lg text-sm font-semibold shadow-sm hover:shadow-md transition-all
                                flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                </svg>
                                <span>Submit Request</span>
                            </button>
                        </form>
                    </div>

                    <!-- Request Details (Hidden by default) -->
                    <div id="complaintDetails" class="hidden detail-animation"></div>

                </div>

                <!-- History Sidebar -->
                <div class="lg:col-span-1">
                    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden lg:sticky lg:top-24">
                        
                        <div class="bg-gradient-to-r from-gray-200 to-gray-100 px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-black/20 rounded-lg flex items-center justify-center">
                                    <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <div>
                                    <h2 class="text-lg font-semibold text-gray">Request History</h2>
                                    <p class="text-blue-400 text-sm">Your submissions</p>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 max-h-[calc(100vh-300px)] overflow-y-auto scrollbar-thin">
                            <% if (complaints.length === 0) { %>
                                <div class="text-center py-12">
                                    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 flex items-center justify-center">
                                        <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                                        </svg>
                                    </div>
                                    <p class="text-sm font-semibold text-slate-700">No Requests Yet</p>
                                    <p class="text-xs text-slate-500 mt-1">Submit your first request to get started</p>
                                </div>
                            <% } else { %>
                                <div class="space-y-3">
                                    <% complaints.forEach(c => { %>
                                        <div class="card-hover cursor-pointer rounded-lg p-4 border border-slate-200 
                                            <%= c.status === STATUS.RESOLVED ? 'bg-green-50 hover:border-green-300' : 'bg-amber-50 hover:border-amber-300' %>"
                                            data-id="<%= c.id %>"
                                            data-subject="<%= c.subject %>"
                                            data-text="<%= c.complaintText %>"
                                            data-response="<%= c.finalResponse || 'No response yet' %>"
                                            data-status="<%= c.status %>"
                                            data-date="<%= new Date(c.createdAt).toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>"
                                            onclick="showComplaint(this)">

                                            <div class="flex items-start justify-between mb-2">
                                                <h3 class="font-semibold text-slate-900 text-sm line-clamp-1 flex-1">
                                                    <%= c.subject %>
                                                </h3>
                                                <span class="status-badge ml-2 px-2 py-0.5 text-[10px] font-semibold rounded-full whitespace-nowrap
                                                    <%= c.status === STATUS.RESOLVED ? 'bg-green-500 text-white' : 'bg-amber-500 text-white' %>">
                                                    <%= c.status %>
                                                </span>
                                            </div>

                                            <p class="text-slate-600 text-xs line-clamp-2 leading-relaxed mb-2">
                                                <%= c.complaintText %>
                                            </p>

                                            <div class="flex items-center justify-between text-xs text-slate-500">
                                                <div class="flex items-center gap-1">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                    <%= new Date(c.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                                                </div>
                                                
                                                <% if (c.status !== STATUS.RESOLVED) { %>
                                                    <button onclick="event.stopPropagation(); withdrawComplaint('<%= c.id %>')"
                                                        class="text-[10px] font-semibold px-2 py-1 rounded-full bg-red-500 text-white hover:bg-red-600 transition">
                                                        Withdraw
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Toggle menu
        function toggleMenu() {
            const menu = document.getElementById("menuDropdown");
            menu.classList.toggle("hidden");
        }

        // Close menu when clicking outside
        document.addEventListener("click", (e) => {
            const menu = document.getElementById("menuDropdown");
            if (!e.target.closest("#menuDropdown") && !e.target.closest("button[onclick='toggleMenu()']")) {
                menu.classList.add("hidden");
            }
        });

        // Withdraw complaint
        function withdrawComplaint(id) {
            if (!confirm('Are you sure you want to withdraw this request?')) return;

            fetch(`/complaints/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                location.reload();
            })
            .catch(err => {
                console.error(err);
                alert('Failed to withdraw request');
            });
        }

        // Show complaint details
        function showComplaint(element) {
            const id = element.getAttribute('data-id');
            const subject = element.getAttribute('data-subject');
            const complaintText = element.getAttribute('data-text');
            const finalResponse = element.getAttribute('data-response');
            const status = element.getAttribute('data-status');
            const date = element.getAttribute('data-date');

            const detailsContainer = document.getElementById('complaintDetails');

            // Toggle logic
            const existingDetail = document.getElementById('complaint-' + id);
            if (existingDetail && !detailsContainer.classList.contains('hidden')) {
                detailsContainer.innerHTML = '';
                detailsContainer.classList.add('hidden');
                return;
            }

            // Status badge styling
            const statusBadge = status === 'RESOLVED' 
                ? 'bg-green-100 text-green-700 border-green-200'
                : 'bg-amber-100 text-amber-700 border-amber-200';

            const responseSection = finalResponse && finalResponse !== 'No response yet'
                ? `
                    <div class="bg-blue-50 rounded-lg p-5 border border-blue-200">
                        <div class="flex items-center gap-2 mb-3">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                            </svg>
                            <p class="text-sm font-semibold text-slate-900">Admin Response</p>
                        </div>
                        <p class="text-sm text-slate-700 leading-relaxed">${finalResponse}</p>
                    </div>
                `
                : `
                    <div class="bg-slate-50 rounded-lg p-5 border border-slate-200 text-center">
                        <svg class="w-12 h-12 text-slate-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p class="text-sm font-medium text-slate-600">No response yet</p>
                        <p class="text-xs text-slate-500 mt-1">Your request is being reviewed</p>
                    </div>
                `;

            // Render details
            detailsContainer.innerHTML = `
                <div id="complaint-${id}" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden detail-animation">
                    <div class="bg-gradient-to-r from-slate-700 to-slate-800 px-6 py-5">
                        <div class="flex items-center justify-between">
                            <div>
                                <h2 class="text-lg font-semibold text-white">Request Details</h2>
                                <p class="text-slate-300 text-sm">Complete information</p>
                            </div>
                            <button onclick="closeDetails()" class="text-white hover:bg-white/10 p-2 rounded-lg transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="p-6 space-y-5">
                        <!-- Request Info -->
                        <div class="flex items-center justify-between flex-wrap gap-3">
                            <div class="flex items-center gap-2 text-sm text-slate-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                </svg>
                                <span class="font-medium">ID:</span> ${id}
                            </div>
                            <div class="flex items-center gap-2 text-sm text-slate-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                ${date}
                            </div>
                            <span class="px-3 py-1.5 text-xs font-semibold rounded-full border ${statusBadge}">
                                ${status}
                            </span>
                        </div>

                        <!-- Subject -->
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Subject</p>
                            <h3 class="text-base font-semibold text-slate-900">${subject}</h3>
                        </div>

                        <!-- Request Description -->
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Your Request</p>
                            <div class="bg-slate-50 rounded-lg p-4 border border-slate-200">
                                <p class="text-sm text-slate-700 leading-relaxed">${complaintText}</p>
                            </div>
                        </div>

                        <!-- Response -->
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase mb-2">Response Status</p>
                            ${responseSection}
                        </div>
                    </div>
                </div>
            `;

            detailsContainer.classList.remove('hidden');

            // Scroll to details on mobile
            if (window.innerWidth < 1024) {
                setTimeout(() => {
                    detailsContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }
        }

        // Close details
        function closeDetails() {
            const detailsContainer = document.getElementById('complaintDetails');
            detailsContainer.innerHTML = '';
            detailsContainer.classList.add('hidden');
        }
    </script>

</body>
</html>