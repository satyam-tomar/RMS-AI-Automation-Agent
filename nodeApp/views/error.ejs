<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#FBF1F1] min-h-screen flex items-center justify-center">

    <div class="row">
            <div class="col-8 offset-2">
                <div class="alert alert-danger shadow-sm p-4" role="alert">
                    <div class="d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                        <h4 class="alert-heading mb-0">Something went wrong!</h4>
                    </div>
                    
                    <hr>
                    
                    <p class="mb-1"><strong>Status Code:</strong> <%= statusCode %></p>
                    <p class="mb-0"><strong>Details:</strong> <%= message %></p>
                    
                    <div class="mt-4">
                        <a href="/" class="btn btn-outline-danger btn-sm">Return Home</a>
                        <button onclick="window.history.back()" class="btn btn-danger btn-sm">Go Back</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>